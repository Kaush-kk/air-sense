#!/bin/bash
export XDG_RUNTIME_DIR="/run/user/$(id -u)"
export DBUS_SESSION_BUS_ADDRESS="unix:path=${XDG_RUNTIME_DIR}/bus"
export PIPEWIRE_RUNTIME_DIR="$XDG_RUNTIME_DIR"

VENV_PY="$HOME/.veer/venv/bin/python"
[ ! -x "$VENV_PY" ] && VENV_PY="$HOME/.air-sense/venv/bin/python"
ENGINE="$HOME/.veer/music_airsense.py"
[ ! -f "$ENGINE" ] && ENGINE="$HOME/.air-sense/music_airsense.py"
CONFIG="$HOME/Vault/airsense_config.json"

case "$1" in
    hud)
        pkill -f "music_airsense.py" 2>/dev/null
        echo "✦ Launching Air-Sense HUD (Press 'Q' inside window to close)..."
        "$VENV_PY" "$ENGINE" --hud
        ;;
    start)
        pkill -f "music_airsense.py" 2>/dev/null
        nohup "$VENV_PY" "$ENGINE" >/dev/null 2>&1 &
        notify-send -u normal -t 2200 "✦ Air-Sense Online" "Static finger-holds & 2-hand spatial tracking active"
        echo "✅ Air-Sense background daemon started."
        ;;
    stop)
        pkill -f "music_airsense.py" 2>/dev/null
        notify-send -u low -t 2000 "✦ Air-Sense Offline" "Webcam released"
        echo "🔇 Air-Sense stopped."
        ;;
    list)
        python3 - << 'PYEOF'
import json, os
p = os.path.expanduser("~/Vault/airsense_config.json")
cfg = json.load(open(p))
print("\n✦ AIR-SENSE GESTURE TABLE (~/Vault/airsense_config.json) ✦")
print("-" * 74)
for k, v in cfg.get("gestures", {}).items():
    print(f"• {k:<18} | {v.get('description','')}")
    print(f"  Action -> {v.get('action','')}\n")
PYEOF
        ;;
    set)
        python3 - << 'PYEOF'
import json, os, sys
sys.stdin = open("/dev/tty", "r")
p = os.path.expanduser("~/Vault/airsense_config.json")
cfg = json.load(open(p))
gestures = list(cfg.get("gestures", {}).keys())
print("\n✦ AIR-SENSE INTERACTIVE GESTURE BUILDER ✦")
for i, g in enumerate(gestures, 1):
    desc = cfg["gestures"][g].get("description", "")
    act = cfg["gestures"][g].get("action", "")
    print(f"  [{i}] {g:<18} ({desc}) -> {act}")
choice = input("\nEnter gesture name or number (1-6): ").strip()
if choice.isdigit() and 1 <= int(choice) <= len(gestures):
    g = gestures[int(choice) - 1]
else:
    g = choice
if g not in cfg.get("gestures", {}):
    print(f"❌ Unknown gesture '{g}'.")
    raise SystemExit(1)
print("\nAvailable Built-in Actions: INTERNAL:NEXT_TRACK | INTERNAL:SMART_HUD | INTERNAL:LOCKDOWN | INTERNAL:EXPAND_SPACE | INTERNAL:COMPRESS_SPACE")
act = input(f"Enter new Linux command or built-in action for '{g}': ").strip()
lbl = input("Enter HUD Banner Label (or press Enter to keep current): ").strip()
if act:
    cfg["gestures"][g]["action"] = act
if lbl:
    cfg["gestures"][g]["label"] = lbl
json.dump(cfg, open(p, "w"), indent=2)
print(f"\n✅ Updated '{g}' -> '{cfg['gestures'][g]['action']}'!")
PYEOF
        ;;
    edit)
        ${EDITOR:-micro} "$CONFIG"
        ;;
    *)
        echo "Usage: air-sense {hud|start|stop|list|set|edit}"
        ;;
esac
